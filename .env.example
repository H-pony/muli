# 可选：访问密码，留空或不设置时直接访问，无需验证。
PASSWORD=

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
# PROXY_SECRET=

# 可选：Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭；不设置时按请求协议自动推导，HTTP 部署无需配置）
# COOKIE_SECURE=

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：影视榜单推荐源（60s API）实例地址，默认官方公共实例 https://60s.viki.moe。
# 官方实例有限流（本项目每小时仅请求 6 次榜单，通常够用）；高频使用可自部署：docker run -d -p 4399:4399 vikiboss/60s:latest
# 60S_API_BASE=https://60s.viki.moe

# 可选：未配置时使用已验证的虎牙、火狐、三六点播接口。
# 显式 [] 关闭默认点播源；自定义数组整体覆盖默认值。
# DEFAULT_SOURCES=[]

# 可选：默认使用内置精选直播频道；不自动拉入上游列表中的未验证条目。
# 显式设置可覆盖默认源；使用 [] 关闭默认源，之后可在设置中手动添加。
# DEFAULT_LIVE_SOURCES=[]
# DEFAULT_LIVE_SOURCES='[{"name":"我的直播源","url":"https://example.com/list.m3u","epg":"https://example.com/epg.xml"}]'

# 可选：详情页高清背景图片来源，仅在服务端读取；也可在客户端“图片与背景”中填写本机凭据。
# 未设置时使用内置已匹配片目，其余影片继续显示原背景。
# TMDB_API_KEY=
# TMDB_READ_TOKEN=

# 可选：调试
DEBUG=false

# 可选：自建镜像仓库地址；默认从源码构建 kongwotv:2.16.12
# 首次部署执行 docker compose up -d --build
# KONGWOTV_IMAGE=your-registry.example/kongwotv:2.16.12
